{
  "name": "ai-comic-production-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI 漫剧制作可视化产品前端 —— 对话区 + 工作区（每步 checkpoint 展示 + ✅/✏️/↩️/🔄 反馈 + 版本归档浏览 + 多集切换）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
