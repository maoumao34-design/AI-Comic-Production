# 本机 / Cloud ComfyUI（复制为环境变量，勿提交真实 Key）
COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_API_KEY=   # 仅 Comfy Cloud 需要；本地可留空
COMFYUI_CKPT=RealVisXL_V5.0_fp16.safetensors
# COMFYUI_MAX_SUBJECTS=characters   # characters | all | 数字；默认 characters（先出 4 个角色三视图）
# COMFYUI_POLL_MS=1500
# COMFYUI_TIMEOUT_MS=300000
# COMFYUI_AUTO_GENERATE=0           # 1=approve 推进下一步时也自动出图（会长时间阻塞）
# COMFYUI_ROOT=E:\ComfyUI

# 视频草稿（步骤 05）
VIDEO_PROVIDER=wan_local
# SEEDANCE_API_KEY=
# KLING_API_KEY=
# ELEVENLABS_API_KEY=

# 后端
PORT=8000
HOST=127.0.0.1
# ASSETS_DIR=
# FAIL_THRESHOLD=3
# BOOTSTRAP_EP01=1                  # 无 episode.json 时仍可预载 EP-01；正常靠 loadWorkspace 恢复
# 持久化：assets/index.json + assets/<集号>/episode.json（集列表/当前步/审阅指针/决策/系列）
